# Discord Credentials
DISCORD_TOKEN=
DISCORD_DEFAULT_PREFIX=

# SQLite Credentials
SQLITE_URL=jdbc:sqlite:database.db

# Spotify Credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Deezer Credentials
# DEEZER_MASTER_DECRYPTION_KEY=

# Tidal Credentials (optional).
# Leave TIDAL_TOKEN blank to disable the Tidal source. Tidal resolves track
# metadata and mirrors playback through YouTube. See:
# https://github.com/topi314/LavaSrc#tidal for how to obtain a token.
# TIDAL_TOKEN=
# TIDAL_COUNTRY_CODE=US

# Dashboard add-on (optional).
# Leave DASHBOARD_WS_URL blank to run the bot standalone with no dashboard.
# Use wss:// in production (the dashboard is on a public host).
# DASHBOARD_WS_URL=wss://dashboard.example.com/
# DASHBOARD_TOKEN=replace-with-a-long-random-shared-secret
# DASHBOARD_BOT_NAME=Nifty
